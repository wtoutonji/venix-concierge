{
  "$schema": "https://schemas.wp.org/wp/7.0/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "useRootPaddingAwareAlignments": true,
    "background": {
      "backgroundImage": false,
      "backgroundSize": false
    },
    "border": {
      "color": false,
      "radius": false,
      "style": false,
      "width": false
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1240px",
      "allowEditing": true,
      "allowCustomContentAndWideSize": false
    },
    "color": {
      "background": true,
      "button": false,
      "caption": false,
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "heading": false,
      "link": false,
      "text": true,
      "palette": [
        {
          "slug": "primary",
          "name": "Primary",
          "color": "#111111"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#0053FF"
        },
        {
          "slug": "background",
          "name": "Background",
          "color": "#FFFFFF"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#F7F7F7"
        },
        {
          "slug": "text",
          "name": "Text",
          "color": "#222222"
        }
      ]
    },
    "dimensions": {
      "aspectRatio": false,
      "defaultAspectRatios": true,
      "height": false,
      "minHeight": false,
      "width": false
    },
    "position": {
      "fixed": false,
      "sticky": false
    },
    "shadow": {
      "defaultPresets": false
    },
    "spacing": {
      "blockGap": true,
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "margin": false,
      "padding": true,
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "XS",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "S",
          "size": "0.75rem"
        },
        {
          "slug": "40",
          "name": "M",
          "size": "1rem"
        },
        {
          "slug": "50",
          "name": "L",
          "size": "1.5rem"
        },
        {
          "slug": "60",
          "name": "XL",
          "size": "2rem"
        },
        {
          "slug": "70",
          "name": "2XL",
          "size": "clamp(3rem,6vw,6rem)"
        },
        {
          "slug": "page-gutter",
          "name": "Page gutter",
          "size": "clamp(1rem,3vw,2rem)"
        },
        {
          "slug": "section",
          "name": "Section",
          "size": "clamp(4rem,8vw,8rem)"
        }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fluid": true,
      "lineHeight": false,
      "textColumns": false,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System",
          "fontFamily": "system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "body",
          "name": "Body",
          "size": "1rem"
        },
        {
          "slug": "lead",
          "name": "Lead",
          "size": "clamp(1.125rem,1.5vw,1.375rem)"
        },
        {
          "slug": "h3",
          "name": "H3",
          "size": "clamp(1.5rem,2.4vw,2rem)"
        },
        {
          "slug": "h2",
          "name": "H2",
          "size": "clamp(2rem,4vw,3.5rem)"
        },
        {
          "slug": "h1",
          "name": "H1",
          "size": "clamp(2.75rem,6vw,5.5rem)"
        }
      ]
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": false
        }
      },
      "core/icon": {
        "dimensions": {
          "width": false
        }
      },
      "core/image": {
        "dimensions": {
          "aspectRatio": true
        }
      },
      "core/pullquote": {
        "border": {
          "color": false,
          "radius": false,
          "style": false,
          "width": false
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|background",
      "text": "var:preset|color|text"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "lineHeight": "1.6"
    }
  }
}
