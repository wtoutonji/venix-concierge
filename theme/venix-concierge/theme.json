{
  "$schema": "https://schemas.wp.org/wp/7.0/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "useRootPaddingAwareAlignments": true,
    "background": { "backgroundImage": false, "backgroundSize": false },
    "border": { "color": false, "radius": false, "style": false, "width": false },
    "layout": { "contentSize": "640px", "wideSize": "1280px", "allowEditing": true, "allowCustomContentAndWideSize": false },
    "color": {
      "background": true, "button": false, "caption": false, "custom": false, "customDuotone": false, "customGradient": false, "defaultDuotone": false, "defaultGradients": false, "defaultPalette": false, "heading": false, "link": false, "text": true,
      "palette": [
        { "slug": "brand", "name": "Brand Burgundy", "color": "#7A1322" }, { "slug": "brand-deep", "name": "Deep Wine", "color": "#5A0E1A" }, { "slug": "brand-dark", "name": "Merlot", "color": "#3D0910" }, { "slug": "brand-ink", "name": "Brand Ink", "color": "#2C1A1D" },
        { "slug": "gold", "name": "Gold", "color": "#C9A75E" }, { "slug": "ivory", "name": "Ivory", "color": "#FAFBF9" }, { "slug": "champagne", "name": "Champagne", "color": "#E6D8C7" }, { "slug": "taupe", "name": "Taupe", "color": "#C8B6A6" },
        { "slug": "blush-light", "name": "Blush Light", "color": "#FBF5F6" }, { "slug": "blush", "name": "Blush", "color": "#F6ECEF" }, { "slug": "blush-dark", "name": "Blush Dark", "color": "#EDE6E8" }, { "slug": "white", "name": "White", "color": "#FFFFFF" }, { "slug": "black", "name": "Black", "color": "#0D0D0D" }, { "slug": "danger", "name": "Danger", "color": "#C0392B" }
      ]
    },
    "dimensions": { "aspectRatio": false, "defaultAspectRatios": true, "height": false, "minHeight": false, "width": false },
    "position": { "fixed": false, "sticky": false },
    "shadow": { "defaultPresets": false, "presets": [ { "slug": "subtle", "name": "Subtle", "shadow": "0 1px 4px rgba(90, 14, 26, 0.04)" }, { "slug": "card", "name": "Card", "shadow": "0 2px 16px rgba(90, 14, 26, 0.06)" }, { "slug": "modal", "name": "Modal", "shadow": "0 8px 40px rgba(90, 14, 26, 0.14)" } ] },
    "spacing": {
      "blockGap": true, "customSpacingSize": false, "defaultSpacingSizes": false, "margin": false, "padding": true, "units": ["px", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        { "slug": "1", "name": "4", "size": "4px" }, { "slug": "2", "name": "8", "size": "8px" }, { "slug": "3", "name": "12", "size": "12px" }, { "slug": "4", "name": "16", "size": "16px" }, { "slug": "5", "name": "20", "size": "20px" }, { "slug": "6", "name": "24", "size": "24px" }, { "slug": "8", "name": "32", "size": "32px" }, { "slug": "10", "name": "40", "size": "40px" }, { "slug": "12", "name": "48", "size": "48px" }, { "slug": "16", "name": "64", "size": "64px" }, { "slug": "20", "name": "80", "size": "80px" }, { "slug": "24", "name": "96", "size": "96px" }, { "slug": "32", "name": "128", "size": "128px" }, { "slug": "section", "name": "Section", "size": "100px" }, { "slug": "section-compact", "name": "Section compact", "size": "60px" }, { "slug": "gutter", "name": "Gutter", "size": "48px" }, { "slug": "gutter-compact", "name": "Gutter compact", "size": "24px" }
      ]
    },
    "typography": {
      "customFontSize": false, "defaultFontSizes": false, "fluid": false, "lineHeight": false, "textColumns": false,
      "fontFamilies": [
        { "slug": "cinzel", "name": "Cinzel", "fontFamily": "Cinzel, \"Noto Serif\", Georgia, serif", "fontFace": [{ "fontFamily": "Cinzel", "fontStyle": "normal", "fontWeight": "400 900", "src": ["file:./assets/fonts/Cinzel-VariableFont_wght.woff2"] }] },
        { "slug": "montserrat", "name": "Montserrat", "fontFamily": "Montserrat, \"Helvetica Neue\", Arial, sans-serif", "fontFace": [{ "fontFamily": "Montserrat", "fontStyle": "normal", "fontWeight": "100 900", "src": ["file:./assets/fonts/Montserrat-VariableFont_wght.woff2"] }] },
        { "slug": "noto-sans-arabic", "name": "Noto Sans Arabic", "fontFamily": "Noto Sans Arabic, sans-serif", "fontFace": [{ "fontFamily": "Noto Sans Arabic", "fontStyle": "normal", "fontWeight": "100 900", "src": ["file:./assets/fonts/NotoSansArabic-VariableFont_wdth,wght.woff2"] }] }
      ],
      "fontSizes": [
        { "slug": "xs", "name": "Extra small", "size": "11px" }, { "slug": "sm", "name": "Small", "size": "13px" }, { "slug": "base", "name": "Base", "size": "15px" }, { "slug": "md", "name": "Medium", "size": "17px" }, { "slug": "lg", "name": "Large", "size": "20px" }, { "slug": "xl", "name": "Extra large", "size": "24px" }, { "slug": "2-xl", "name": "2XL", "size": "30px" }, { "slug": "3-xl", "name": "3XL", "size": "38px" }, { "slug": "4-xl", "name": "4XL", "size": "52px" }, { "slug": "5-xl", "name": "5XL", "size": "68px" }, { "slug": "6-xl", "name": "6XL", "size": "90px" }
      ]
    },
    "blocks": { "core/button": { "border": { "radius": false } }, "core/icon": { "dimensions": { "width": false } }, "core/image": { "dimensions": { "aspectRatio": true } }, "core/pullquote": { "border": { "color": false, "radius": false, "style": false, "width": false } } }
  },
  "styles": {
    "color": { "background": "var:preset|color|ivory", "text": "var:preset|color|brand-ink" },
    "typography": { "fontFamily": "var:preset|font-family|montserrat", "fontSize": "var:preset|font-size|base", "lineHeight": "1.6" },
    "elements": { "link": { "color": { "text": "var:preset|color|brand" } }, "heading": { "color": { "text": "var:preset|color|brand" }, "typography": { "fontFamily": "var:preset|font-family|cinzel", "fontWeight": "400", "lineHeight": "1.3" } } }
  }
}
